{
  "realm": "helpdesk",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "REQUESTER", "description": "Employee who submits tickets" },
      { "name": "AGENT", "description": "Support agent who handles tickets" },
      { "name": "TEAM_LEAD", "description": "Leads a support team and assigns tickets" },
      { "name": "ADMIN", "description": "Manages users, teams and categories" }
    ]
  },
  "clients": [
    {
      "clientId": "helpdesk-frontend",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "requester",
      "email": "requester@example.com",
      "firstName": "Demo",
      "lastName": "Requester",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "requester", "temporary": false }],
      "realmRoles": ["REQUESTER"]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "agent",
      "email": "agent@example.com",
      "firstName": "Demo",
      "lastName": "Agent",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "agent", "temporary": false }],
      "realmRoles": ["AGENT"]
    },
    {
      "id": "33333333-3333-4333-8333-333333333333",
      "username": "lead",
      "email": "lead@example.com",
      "firstName": "Demo",
      "lastName": "Lead",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "lead", "temporary": false }],
      "realmRoles": ["AGENT", "TEAM_LEAD"]
    },
    {
      "id": "44444444-4444-4444-8444-444444444444",
      "username": "admin",
      "email": "admin@example.com",
      "firstName": "Demo",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["ADMIN"]
    }
  ]
}